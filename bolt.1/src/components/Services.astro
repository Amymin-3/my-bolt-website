---
const services = [
  {
    category: "Home Repair",
    items: ["Plumbing (wiring, sockets)", "Home Maintenance (doors, pipes, painting, flooring, windows...)"],
    icon: "🏠" // Example icon
  },
  {
    category: "Specific Equipment Repair",
    items: ["Rolling door repair", "Corrugated iron roof repair", "Air conditioner brackets"],
    icon: "🔧" // Example icon
  },
  {
    category: "Outdoor Equipment",
    items: ["Garden sprinkler systems"],
    icon: "🌳" // Example icon
  },
  {
    category: "School Facility Maintenance",
    items: ["Basketball hoop replacement & reinforcement", "Wall padding", "Sandpit maintenance", "Facility painting maintenance..."],
    icon: "🏫" // Example icon
  },
   {
    category: "Specialty Services",
    items: ["Welding engineering"],
    icon: "⚙️" // Example icon
  }
];
---
<section id="services" class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-12 text-brand-text">Our Services</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map(service => (
        <div class="bg-brand-beige p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
          <div class="text-4xl mb-4">{service.icon}</div>
          <h3 class="text-xl font-semibold mb-3 text-brand-text">{service.category}</h3>
          <ul class="list-disc list-inside text-gray-700 space-y-1">
            {service.items.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
     <div class="text-center mt-12">
        <a href="#contact" class="bg-brand-yellow hover:bg-opacity-80 text-brand-text font-bold py-3 px-6 rounded-lg transition duration-300">
          Book Home Repair Now
        </a>
         <a href="#contact" class="ml-4 border border-brand-yellow text-brand-yellow hover:bg-brand-yellow hover:text-brand-text font-bold py-3 px-6 rounded-lg transition duration-300">
          School Maintenance Inquiry
        </a>
      </div>
  </div>
</section>
