         <a href="#" class="mt-2 bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded inline-flex items-center"> {/* Replace # with actual Line link */}
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="..."></path></svg> {/* Add Line icon SVG path if desired */}
          Add Us on Line
        </a>
      </div>
      {/* Email & Address */}
      <div class="bg-white text-brand-text p-6 rounded-lg shadow-md">
        <h3 class="text-xl font-semibold mb-2">Email & Address</h3>
        <p class="mb-2">Email: <a href="mailto:info@fatherhuang.com" class="text-blue-600 hover:underline">info@fatherhuang.com</a></p> {/* Replace with actual email */}
        <p>Address: [Your Company Address, e.g., Taipei City, Taiwan]</p> {/* Replace with actual address */}
      </div>
    </div>
