        <h3 class="text-xl font-semibold mb-2">Phone</h3>
        <p class="mb-2">General Inquiries: <a href="tel:+886XXXXXXXXX" class="text-blue-600 hover:underline">09XX-XXX-XXX</a></p> {/* Replace with actual number */}
        <p>School Inquiries: <a href="tel:+886YYYYYYYYY" class="text-blue-600 hover:underline">09YY-YYY-YYY</a></p> {/* Replace with actual number */}
      </div>
      {/* Line */}
